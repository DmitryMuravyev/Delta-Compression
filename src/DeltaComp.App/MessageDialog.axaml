<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeltaComp.MessageDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="Auto,*" Margin="16">
        <Border Name="IconBorder" Grid.Row="0" Grid.Column="0" Width="32" Height="32" CornerRadius="16" Margin="0,0,14,0" VerticalAlignment="Top">
            <TextBlock Name="IconText" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <SelectableTextBlock Name="MessageText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Name="OkButton" Grid.Row="1" Grid.ColumnSpan="2" Content="OK" Width="90" HorizontalAlignment="Right"
                HorizontalContentAlignment="Center" Margin="0,16,0,0" IsDefault="True" IsCancel="True" Click="OkButton_Click"/>
    </Grid>
</Window>
