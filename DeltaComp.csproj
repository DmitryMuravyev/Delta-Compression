<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Allows building (not running) the WPF app on Linux/macOS CI -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Sub-projects live in their own folders and must not be globbed into the app -->
    <DefaultItemExcludes>$(DefaultItemExcludes);DeltaComp.Core/**;Benchmarks/**;Release/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <ApplicationIcon>Application_icon.ico</ApplicationIcon>
    <Copyright>Dmitry Muravyev</Copyright>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="DeltaComp.Core\DeltaComp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Application_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Header_Source.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Header_Transformation.xslt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
